# Production's connection string, for the migration rehearsal.
#
# Copy this file to .rehearsal.env and replace [YOUR-PASSWORD] with the real
# password. .rehearsal.env is gitignored; this example file is not, so never
# put the real password here.
#
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# The pooler URI is fine for pg_dump.
#
# This is only ever read from. The rehearsal never writes to production.

PROD_DB_URL="postgresql://postgres.xnusvnwzvinhopkwmljl:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"
